generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  phoneNumber       String    @unique
  email             String?   @unique
  // Nullable at the DB level even though the EmailSetupScreen now requires it for new
  // signups (2026-10-22) - existing users who already skipped can't be backfilled, so
  // "mandatory" is enforced in the signup UI only, not here.
  city              String?
  // Temporary promo/referral campaign (2026-10-23 - Vikum's own words: "this service
  // is temporary... when I want to remove this from the app, we need to do this").
  // promoCode: this user's own shareable code, auto-generated on login (verify-otp),
  // idempotent - generated once, never regenerated. referredByCode: the code THIS
  // user entered at their own signup (EmailSetupScreen), set once, never overwritten.
  // Counting signups per code for payout is a manual SQL query against this table,
  // not a built admin feature - deliberately no new endpoint/screen for something
  // explicitly temporary. Removal later = delete these 2 columns + the Profile card +
  // the EmailSetupScreen field + the generation call in verify-otp.
  promoCode         String?   @unique
  referredByCode    String?
  userType          String?
  pushToken         String?
  notificationPrefs String?
  profilePhotoUrl   String?
  tokenVersion      Int       @default(0)
  // Account deletion (2026-10-25): set at request time to now+14 days. A scheduled job
  // hard-deletes once this passes; logging back in before then clears it (cancels the
  // pending deletion). See backend/src/utils/accountDeletion.ts for the full flow.
  pendingDeletionAt DateTime?
  // Admin panel (2026-10-26): written once-per-user-per-day in authMiddleware from the
  // X-App-Version/X-Platform request headers. Used by M9 (app health) to show the real
  // version spread among recently-active users - never blocks or slows the request.
  lastAppVersion    String?
  lastPlatform      String?
  createdAt         DateTime  @default(now())
  vehicles          Vehicle[]
  garage            Garage?
}

// Admin panel (2026-10-26) - one row per user per day they made an authenticated
// request, written (fire-and-forget, never awaited) from authMiddleware. Deliberately
// no relation to User (keeps the User model itself untouched) - userId is just a plain
// string, looked up separately wherever needed. Powers M7 (retention) and M8 (DAU/MAU).
model UserActiveDay {
  id     String @id @default(cuid())
  userId String
  day    String // "2026-10-25" in Asia/Colombo, not UTC
  @@unique([userId, day])
  @@index([day])
}

// Admin panel (2026-10-26) - one row per 5xx response, written fire-and-forget from a
// global Express middleware. route is always the route PATTERN (e.g. "/vehicles/:id"),
// never the real URL - no bodies, query strings, phone numbers, or tokens are ever
// stored here. Rows older than 30 days are pruned by the first /admin/health call of
// each day. Powers M9 (app health).
model ApiErrorLog {
  id        String   @id @default(cuid())
  method    String
  route     String
  status    Int
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Admin panel (2026-10-26) - one row per daily backup run, written at the end of
// dbBackupToR2.ts (success or failure). Writing this row must never mask a real
// failure - the GitHub Actions workflow still exits non-zero on failure regardless
// of whether this row was written successfully. Powers M9's "last backup" status.
model BackupRun {
  id        String   @id @default(cuid())
  status    String   // "ok" | "failed"
  sizeBytes Int?
  note      String?
  createdAt DateTime @default(now())
}

model Vehicle {
  id             String              @id @default(cuid())
  registrationNo String              @unique
  make           String
  model          String
  year           Int
  fuelType       String
  vehicleType    String?
  mileage        Int
  ownerPhone     String
  purchaseDate   DateTime?
  ownerCount                Int?                @default(1)
  vehicleNotes              String?
  photoUrl                  String?
  emissionTestExpiry        DateTime?
  revenueLicenceExpiry      DateTime?
  insuranceExpiry           DateTime?
  insuranceCompany          String?
  insurancePolicyNo         String?
  insurancePolicyHistory    Json?
  revenueLicenceHistory     Json?
  lastEmissionReminderSent  DateTime?
  lastLicenceReminderSent   DateTime?
  lastInsuranceReminderSent DateTime?
  intervalOverrides         Json?
  neverDoneConfirmed        Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  owner          User                @relation(fields: [ownerPhone], references: [phoneNumber])
  serviceRecords ServiceRecord[]
  fuelLogs       FuelLog[]
  expenses       Expense[]
  shareSessions  ShareSession[]
  submissions    ServiceSubmission[]
  transfers      VehicleTransfer[]
  bookings       Booking[]
  vehicleShares  VehicleShare[]
}

model ServiceRecord {
  id             String   @id @default(cuid())
  vehicleId      String
  date           DateTime
  description    String
  mileage        Int?
  parts          String?
  brand          String?
  cost           Float?
  notes          String?
  photos         String[]
  structuredData Json?
  createdAt      DateTime @default(now())
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  vehicleId   String
  date        DateTime
  category    String
  amount      Float
  description String?
  mileage     Int?
  notes       String?
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model FuelLog {
  id        String   @id @default(cuid())
  vehicleId String
  date      DateTime
  mileage   Int
  litres    Float?
  kWh       Float?
  cost      Float?
  fullTank  Boolean  @default(true)
  station   String?
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model Garage {
  id            String               @id @default(cuid())
  ownerPhone    String               @unique
  name          String
  address       String?
  addressLine   String?
  village       String?
  town          String?
  brNumber      String?
  verified      Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  owner         User                 @relation(fields: [ownerPhone], references: [phoneNumber])
  shareSessions ShareSession[]
  submissions   ServiceSubmission[]
  availability      GarageAvailability?
  bookings          Booking[]
  calendarOverrides GarageCalendarOverride[]
  reminders         GarageReminder[]
  ratings           GarageRating[]
  priceList         Json?
  photos        String[]
  aboutBio      String?
  services      String[]
  contactPhone  String?
  promoText     String?
  websiteUrl    String?
  googleMapsUrl String?
}

model GarageReminder {
  id        String   @id @default(cuid())
  garageId  String
  vehicleId String
  sentAt    DateTime @default(now())
  garage    Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  @@unique([garageId, vehicleId])
}

model GarageRating {
  id           String   @id @default(cuid())
  garageId     String
  vehicleId    String
  ownerPhone   String
  submissionId String   @unique
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())
  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

model ShareSession {
  id              String   @id @default(cuid())
  vehicleId       String
  garageId        String
  ownerPhone      String
  status          String   @default("active")
  serviceType     String?
  sharedRecordIds String   @default("[]")
  createdAt       DateTime @default(now())
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  garage          Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

model VehicleTransfer {
  id          String   @id @default(cuid())
  vehicleId   String
  sellerPhone String
  buyerPhone  String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model GarageAvailability {
  id        String  @id @default(cuid())
  garageId  String  @unique
  workDays  String  @default("[1,2,3,4,5]")
  maxPerDay Int     @default(5)
  timeSlots String  @default("[\"Morning\",\"Afternoon\"]")
  garage    Garage  @relation(fields: [garageId], references: [id], onDelete: Cascade)
}

model GarageCalendarOverride {
  id           String   @id @default(cuid())
  garageId     String
  date         String
  status       String   @default("open")
  maxSlots     Int?
  message      String?
  messageColor String?
  createdAt    DateTime @default(now())
  garage       Garage   @relation(fields: [garageId], references: [id], onDelete: Cascade)
  @@unique([garageId, date])
}

model Booking {
  id             String        @id @default(cuid())
  vehicleId      String
  garageId       String
  ownerPhone     String
  date           DateTime
  slotLabel      String?
  status         String        @default("pending")
  notes          String?
  noteType       String        @default("normal")
  serviceType    String?
  shareSessionId String?
  reminderSent   Boolean       @default(false)
  reminder1hSent Boolean       @default(false)
  counterDate    DateTime?
  counterSlot    String?
  // Cost Forecast Improvement 2 (2026-10-22): predicted/upcoming services the owner
  // explicitly requested at booking time, snapshotted as {name, estimatedCost} since
  // predictions recompute as mileage changes - storing the live value would drift from
  // what the owner actually saw and picked. Separate from shareSessionId (which attaches
  // past completed records) - this is a forward-looking request, not history.
  requestedServices Json?
  createdAt      DateTime      @default(now())
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  garage         Garage        @relation(fields: [garageId], references: [id], onDelete: Cascade)
  bookingNotes   BookingNote[]
}

model BookingNote {
  id          String   @id @default(cuid())
  bookingId   String
  senderPhone String
  message     String
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model AppNotification {
  id        String   @id @default(cuid())
  userPhone String
  type      String
  title     String
  body      String
  linkTo    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VehicleShare {
  id              String   @id @default(cuid())
  vehicleId       String
  ownerPhone      String
  sharedWithPhone String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@unique([vehicleId, sharedWithPhone])
}

model ServiceSubmission {
  id               String    @id @default(cuid())
  shareSessionId   String?
  bookingId        String?
  vehicleId        String
  garageId         String?
  submittedByPhone String?
  ownerPhone       String
  description      String
  serviceDate      DateTime?
  parts            String?
  brand            String?
  mileage          Int?
  cost             Float?
  notes            String?
  structuredData   Json?
  categories       String[] @default([])
  photos           String[]
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  vehicle          Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  garage           Garage?  @relation(fields: [garageId], references: [id], onDelete: Cascade)
}
