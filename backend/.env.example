# Copy this file to .env and fill in real values. Never commit the real .env.
# (See CLAUDE.md for where to get each value — Neon dashboard, Cloudflare R2 dashboard, etc.)

PORT=3001
JWT_SECRET=your-jwt-secret-here
DATABASE_URL="your-neon-connection-string-here"

R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-domain.r2.dev

# --- Vocksy Mart (Step 0.5) ---
# Comma-separated phone numbers (same format the app normalizes to, e.g. +94771234567).
# ADMIN_PHONES: who gets a push + sees GET /admin/reports when a Mart report is filed.
ADMIN_PHONES=
# MART_BETA_PHONES: only these phones can reach any /mart route while testing.
# Empty or unset = Mart is open to everyone (do not leave empty after the beta phase).
MART_BETA_PHONES=
# MART_SUPPORT_WHATSAPP: leave empty until there's a real number — the app hides the
# Customer Service row in My Mart while this is empty.
MART_SUPPORT_WHATSAPP=
